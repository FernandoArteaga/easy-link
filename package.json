{
	"name": "easy-link",
	"private": true,
	"version": "1.4.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">= 24.12.0",
		"pnpm": ">= 11.0.0",
		"npm": "please use pnpm"
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "vite dev",
		"dev:network": "vite dev --host",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "eslint --fix && prettier --write .",
		"fmt:check": "eslint && prettier --check .",
		"firebase-emulator:start": "firebase emulators:start --import=./.firebase-emulator-data --export-on-exit",
		"firebase-emulator:export": "firebase emulators:export ./.firebase-emulator-data"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"firebase": "^13.3.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^5.0.4",
		"@skeletonlabs/skeleton-svelte": "^5.0.4",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"firebase-tools": "^15.36.0",
		"globals": "^17.14.0",
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	}
}
