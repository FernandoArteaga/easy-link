{
	"name": "easy-link",
	"private": true,
	"version": "1.3.0",
	"type": "module",
	"engines": {
		"node": ">= 24.2.0",
		"pnpm": ">= 10.0.0",
		"npm": "please use pnpm"
	},
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "vite dev",
		"dev:network": "vite dev --host",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "eslint --fix && prettier --write .",
		"fmt:check": "eslint && prettier --check .",
		"firebase-emulator:start": "firebase emulators:start --import=./.firebase-emulator-data --export-on-exit",
		"firebase-emulator:export": "firebase emulators:export ./.firebase-emulator-data"
	},
	"dependencies": {
		"firebase": "^12.7.0",
		"lucide-svelte": "0.562.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^9.39.2",
		"@skeletonlabs/skeleton": "^4.9.0",
		"@skeletonlabs/skeleton-svelte": "^4.9.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.1.18",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.51.0",
		"vite": "^7.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@firebase/util",
			"@tailwindcss/oxide",
			"esbuild"
		]
	}
}
